{
 "about": "Validity is the half-open wall-clock interval and a monotonic deadline; rollback does not extend it.",
 "theorems": [
  "TIME-01"
 ],
 "policy": {
  "schema": 2,
  "adapter": "https",
  "service": "demo-service",
  "host": "api.example.org",
  "authentication": "x-api-key",
  "credential_source": {
   "kind": "command",
   "argv": [
    "mytool",
    "auth",
    "print-token"
   ],
   "inherit_env": [
    "XDG_CONFIG_HOME"
   ]
  },
  "operations": [
   {
    "name": "profile.read",
    "effect": "read",
    "method": "GET",
    "path": "/v1/account"
   },
   {
    "name": "issue.view",
    "effect": "read",
    "method": "GET",
    "path": "/v1/issues/{issue}",
    "parameters": {
     "issue": [
      23,
      24
     ]
    }
   },
   {
    "name": "issue.list",
    "effect": "read",
    "method": "GET",
    "path": "/v1/issues",
    "query": {
     "state": "open",
     "page": "{page}"
    },
    "parameters": {
     "page": {
      "min": 1,
      "max": 50
     }
    }
   },
   {
    "name": "issue.comment",
    "effect": "write",
    "method": "POST",
    "path": "/v1/issues/{issue}/comments",
    "parameters": {
     "issue": [
      23,
      24
     ]
    },
    "body_fields": {
     "body": 100
    }
   }
  ],
  "lifetime_seconds": 60,
  "max_requests": 5,
  "max_body_bytes": 100
 },
 "write_mode": "deny",
 "clock": {
  "wall": 1000,
  "mono": 100
 },
 "steps": [
  {
   "do": "request",
   "grant": "root",
   "clock": {
    "wall": 999,
    "mono": 100
   },
   "request": {
    "operation": "profile.read",
    "arguments": {}
   },
   "expect": {
    "code": "expired"
   }
  },
  {
   "do": "request",
   "grant": "root",
   "clock": {
    "wall": 1000,
    "mono": 100
   },
   "request": {
    "operation": "profile.read",
    "arguments": {}
   },
   "expect": {
    "code": "ok"
   }
  },
  {
   "do": "request",
   "grant": "root",
   "clock": {
    "wall": 1059,
    "mono": 159
   },
   "request": {
    "operation": "profile.read",
    "arguments": {}
   },
   "expect": {
    "code": "ok"
   }
  },
  {
   "do": "request",
   "grant": "root",
   "clock": {
    "wall": 1060,
    "mono": 159
   },
   "request": {
    "operation": "profile.read",
    "arguments": {}
   },
   "expect": {
    "code": "expired"
   }
  },
  {
   "do": "request",
   "grant": "root",
   "clock": {
    "wall": 1000,
    "mono": 160
   },
   "request": {
    "operation": "profile.read",
    "arguments": {}
   },
   "expect": {
    "code": "expired"
   }
  },
  {
   "do": "request",
   "grant": "root",
   "clock": {
    "wall": 1030,
    "mono": 130
   },
   "request": {
    "operation": "profile.read",
    "arguments": {}
   },
   "expect": {
    "code": "ok"
   }
  }
 ]
}
