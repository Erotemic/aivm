{
  "schema": 2,
  "adapter": "https",
  "service": "corp-gitlab",
  "host": "gitlab.corp.example",
  "authentication": "bearer",
  "egress": {
    "address": "10.20.30.40",
    "port": 8443,
    "ca_file": "/etc/ssl/certs/corp-root-ca.pem"
  },
  "credential_source": {
    "kind": "file",
    "path": "/home/operator/.config/aivm/secrets/corp-gitlab.token"
  },
  "operations": [
    {"name": "account.read", "effect": "read", "method": "GET", "path": "/api/v4/user"},
    {
      "name": "mr.view",
      "effect": "read",
      "method": "GET",
      "path": "/api/v4/projects/{project}/merge_requests/{mr}",
      "parameters": {"project": [42], "mr": {"min": 1, "max": 5000}}
    }
  ],
  "lifetime_seconds": 900,
  "max_requests": 60
}
