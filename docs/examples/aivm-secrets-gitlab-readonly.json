{
  "schema": 2,
  "adapter": "https",
  "service": "gitlab-profile",
  "host": "gitlab.com",
  "authentication": "bearer",
  "credential_source": {
    "kind": "command",
    "argv": ["op", "read", "op://Work/GitLab/personal-token"],
    "inherit_env": ["XDG_CONFIG_HOME"]
  },
  "operations": [
    {"name": "account.read", "effect": "read", "method": "GET", "path": "/api/v4/user"}
  ],
  "lifetime_seconds": 900,
  "max_requests": 30,
  "max_body_bytes": 2048
}
