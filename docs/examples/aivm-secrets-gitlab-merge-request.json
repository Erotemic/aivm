{
  "schema": 2,
  "adapter": "https",
  "service": "gitlab-mr-review",
  "host": "gitlab.com",
  "authentication": "bearer",
  "credential_source": {
    "kind": "command",
    "argv": ["op", "read", "op://Work/GitLab/personal-token"],
    "inherit_env": ["XDG_CONFIG_HOME"]
  },
  "operations": [
    {
      "name": "mr.view",
      "effect": "read",
      "method": "GET",
      "path": "/api/v4/projects/{project}/merge_requests/{mr}",
      "parameters": {"project": [278964], "mr": [101, 102]}
    },
    {
      "name": "mr.diffs",
      "effect": "read",
      "method": "GET",
      "path": "/api/v4/projects/{project}/merge_requests/{mr}/diffs",
      "query": {"per_page": "100", "page": "{page}"},
      "parameters": {
        "project": [278964],
        "mr": [101, 102],
        "page": {"min": 1, "max": 20}
      }
    },
    {
      "name": "mr.notes",
      "effect": "read",
      "method": "GET",
      "path": "/api/v4/projects/{project}/merge_requests/{mr}/notes",
      "query": {"per_page": "100", "page": "{page}", "sort": "asc"},
      "parameters": {
        "project": [278964],
        "mr": [101, 102],
        "page": {"min": 1, "max": 20}
      }
    },
    {
      "name": "mr.pipelines",
      "effect": "read",
      "method": "GET",
      "path": "/api/v4/projects/{project}/merge_requests/{mr}/pipelines",
      "parameters": {"project": [278964], "mr": [101, 102]}
    },
    {
      "name": "mr.note",
      "effect": "write",
      "method": "POST",
      "path": "/api/v4/projects/{project}/merge_requests/{mr}/notes",
      "parameters": {"project": [278964], "mr": [101]},
      "body_fields": {"body": 4096}
    }
  ],
  "lifetime_seconds": 1800,
  "max_requests": 100,
  "max_body_bytes": 4096
}
