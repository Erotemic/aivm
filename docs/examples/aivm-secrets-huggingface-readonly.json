{
  "schema": 2,
  "adapter": "https",
  "service": "huggingface-readonly",
  "host": "huggingface.co",
  "authentication": "bearer",
  "credential_source": {
    "kind": "file",
    "path": "/home/operator/.config/aivm/secrets/huggingface.token"
  },
  "operations": [
    {"name": "account.read", "method": "GET", "path": "/api/whoami-v2"},
    {
      "name": "model.info",
      "method": "GET",
      "path": "/api/models/{namespace}/{model}",
      "parameters": {
        "namespace": ["my-org"],
        "model": ["detector-v1", "detector-v2"]
      }
    }
  ],
  "lifetime_seconds": 900,
  "max_requests": 50
}
