{
  "schema": 2,
  "adapter": "https",
  "service": "github-issues",
  "host": "api.github.com",
  "authentication": "bearer",
  "headers": {"X-GitHub-Api-Version": "2026-03-10"},
  "credential_source": {
    "kind": "command",
    "argv": ["gh", "auth", "token", "--hostname", "github.com"],
    "inherit_env": [
      "DBUS_SESSION_BUS_ADDRESS",
      "GH_CONFIG_DIR",
      "XDG_CONFIG_HOME",
      "XDG_RUNTIME_DIR"
    ]
  },
  "operations": [
    {
      "name": "issue.view",
      "method": "GET",
      "path": "/repos/{owner}/{repo}/issues/{issue}",
      "accept": "application/vnd.github+json",
      "parameters": {"owner": ["Erotemic"], "repo": ["aivm"], "issue": [24, 25]}
    },
    {
      "name": "issue.comments",
      "method": "GET",
      "path": "/repos/{owner}/{repo}/issues/{issue}/comments",
      "accept": "application/vnd.github+json",
      "query": {"per_page": "100", "page": "{page}"},
      "parameters": {
        "owner": ["Erotemic"],
        "repo": ["aivm"],
        "issue": [24, 25],
        "page": {"min": 1, "max": 50}
      }
    },
    {
      "name": "issue.comment",
      "method": "POST",
      "path": "/repos/{owner}/{repo}/issues/{issue}/comments",
      "accept": "application/vnd.github+json",
      "parameters": {"owner": ["Erotemic"], "repo": ["aivm"], "issue": [24]},
      "body_fields": {"body": 8192}
    }
  ],
  "lifetime_seconds": 1800,
  "max_requests": 100,
  "max_body_bytes": 8192
}
