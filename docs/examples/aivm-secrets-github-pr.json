{
  "adapter": "https",
  "authentication": "bearer",
  "checks": {
    "pull": {
      "accept": "application/vnd.github+json",
      "bind": {
        "head_sha": {
          "at": [
            "head",
            "sha"
          ],
          "format": "hex"
        }
      },
      "path": "/repos/{repository}/pulls/{pr}",
      "require": [
        {
          "at": [
            "number"
          ],
          "equals_parameter": "pr",
          "fold": false
        },
        {
          "at": [
            "base",
            "repo",
            "full_name"
          ],
          "equals": "example-org/example-repo",
          "fold": true
        },
        {
          "at": [
            "user",
            "login"
          ],
          "equals": "octocat",
          "fold": true
        },
        {
          "at": [
            "head",
            "repo",
            "full_name"
          ],
          "equals": "octocat/example-repo",
          "fold": true
        }
      ]
    }
  },
  "cli": {
    "gh": [
      {
        "command": [
          "pr",
          "checks"
        ],
        "operation": "pr.checks",
        "options": {
          "--page": "page",
          "--repo": "repository",
          "-R": "repository"
        },
        "output": "reply",
        "positional": [
          "pr"
        ]
      },
      {
        "command": [
          "pr",
          "comment"
        ],
        "operation": "pr.comment",
        "options": {
          "--body": "body",
          "--body-file": "@body",
          "--repo": "repository",
          "-R": "repository"
        },
        "output": "reply",
        "positional": [
          "pr"
        ]
      },
      {
        "command": [
          "pr",
          "comments"
        ],
        "operation": "pr.comments",
        "options": {
          "--page": "page",
          "--repo": "repository",
          "-R": "repository"
        },
        "output": "reply",
        "positional": [
          "pr"
        ]
      },
      {
        "command": [
          "pr",
          "diff"
        ],
        "operation": "pr.diff",
        "options": {
          "--repo": "repository",
          "-R": "repository"
        },
        "output": "result",
        "positional": [
          "pr"
        ]
      },
      {
        "command": [
          "pr",
          "edit"
        ],
        "operation": "pr.edit",
        "options": {
          "--body": "body",
          "--body-file": "@body",
          "--repo": "repository",
          "--title": "title",
          "-R": "repository"
        },
        "output": "reply",
        "positional": [
          "pr"
        ]
      },
      {
        "command": [
          "pr",
          "review-comments"
        ],
        "operation": "pr.review-comments",
        "options": {
          "--page": "page",
          "--repo": "repository",
          "-R": "repository"
        },
        "output": "reply",
        "positional": [
          "pr"
        ]
      },
      {
        "command": [
          "pr",
          "review-threads"
        ],
        "operation": "pr.review-threads",
        "options": {
          "--repo": "repository",
          "-R": "repository"
        },
        "output": "reply",
        "positional": [
          "pr"
        ]
      },
      {
        "command": [
          "pr",
          "reviews"
        ],
        "operation": "pr.reviews",
        "options": {
          "--page": "page",
          "--repo": "repository",
          "-R": "repository"
        },
        "output": "reply",
        "positional": [
          "pr"
        ]
      },
      {
        "command": [
          "pr",
          "summary"
        ],
        "operation": "pr.summary",
        "options": {
          "--repo": "repository",
          "-R": "repository"
        },
        "output": "reply",
        "positional": [
          "pr"
        ]
      },
      {
        "command": [
          "pr",
          "view"
        ],
        "operation": "pr.view",
        "options": {
          "--repo": "repository",
          "-R": "repository"
        },
        "output": "reply",
        "positional": [
          "pr"
        ]
      }
    ]
  },
  "credential_source": {
    "argv": [
      "gh",
      "auth",
      "token",
      "--hostname",
      "github.com"
    ],
    "inherit_env": [
      "DBUS_SESSION_BUS_ADDRESS",
      "GH_CONFIG_DIR",
      "XDG_CONFIG_HOME",
      "XDG_RUNTIME_DIR"
    ],
    "kind": "command"
  },
  "egress": {
    "port": 443
  },
  "headers": {
    "X-GitHub-Api-Version": "2026-03-10"
  },
  "host": "api.github.com",
  "lifetime_seconds": 1800,
  "max_body_bytes": 8192,
  "max_requests": 200,
  "operations": [
    {
      "accept": "application/vnd.github+json",
      "defaults": {
        "page": 1
      },
      "effect": "read",
      "fold": [
        "repository"
      ],
      "method": "GET",
      "name": "pr.checks",
      "page": {
        "at": [
          "check_runs"
        ],
        "parameter": "page",
        "size": 100
      },
      "parameters": {
        "page": {
          "max": 10000,
          "min": 1
        },
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "path": "/repos/{repository}/commits/{head_sha}/check-runs",
      "query": {
        "page": "{page}",
        "per_page": "100"
      },
      "requires": "pull",
      "response": "json"
    },
    {
      "accept": "application/vnd.github+json",
      "body_fields": {
        "body": {
          "max_bytes": 16384,
          "optional": false
        }
      },
      "effect": "write",
      "fold": [
        "repository"
      ],
      "method": "POST",
      "name": "pr.comment",
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "path": "/repos/{repository}/issues/{pr}/comments",
      "requires": "pull",
      "response": "json"
    },
    {
      "accept": "application/vnd.github+json",
      "defaults": {
        "page": 1
      },
      "effect": "read",
      "fold": [
        "repository"
      ],
      "method": "GET",
      "name": "pr.comments",
      "page": {
        "at": [],
        "parameter": "page",
        "size": 100
      },
      "parameters": {
        "page": {
          "max": 10000,
          "min": 1
        },
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "path": "/repos/{repository}/issues/{pr}/comments",
      "query": {
        "page": "{page}",
        "per_page": "100"
      },
      "requires": "pull",
      "response": "json"
    },
    {
      "accept": "application/vnd.github.diff",
      "effect": "read",
      "fold": [
        "repository"
      ],
      "method": "GET",
      "name": "pr.diff",
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "path": "/repos/{repository}/pulls/{pr}",
      "requires": "pull",
      "response": "text"
    },
    {
      "accept": "application/vnd.github+json",
      "body_fields": {
        "body": {
          "max_bytes": 16384,
          "optional": true
        },
        "title": {
          "max_bytes": 256,
          "optional": true
        }
      },
      "effect": "write",
      "fold": [
        "repository"
      ],
      "method": "PATCH",
      "name": "pr.edit",
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "path": "/repos/{repository}/pulls/{pr}",
      "requires": "pull",
      "response": "json"
    },
    {
      "accept": "application/vnd.github+json",
      "defaults": {
        "page": 1
      },
      "effect": "read",
      "fold": [
        "repository"
      ],
      "method": "GET",
      "name": "pr.review-comments",
      "page": {
        "at": [],
        "parameter": "page",
        "size": 100
      },
      "parameters": {
        "page": {
          "max": 10000,
          "min": 1
        },
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "path": "/repos/{repository}/pulls/{pr}/comments",
      "query": {
        "page": "{page}",
        "per_page": "100"
      },
      "requires": "pull",
      "response": "json"
    },
    {
      "accept": "application/vnd.github+json",
      "defaults": {
        "name": "example-repo",
        "owner": "example-org"
      },
      "effect": "read",
      "fold": [
        "repository"
      ],
      "graphql": {
        "document": "query AivmReviewThreads($owner: String!, $name: String!, $number: Int!) { repository(owner: $owner, name: $name) { pullRequest(number: $number) { number reviewThreads(first: 100) { nodes { id isResolved comments(first: 100) { nodes { id body path line author { login } } pageInfo { hasNextPage endCursor } } } pageInfo { hasNextPage endCursor } } } } }",
        "operation": "AivmReviewThreads",
        "variables": {
          "name": "name",
          "number": "pr",
          "owner": "owner"
        }
      },
      "method": "POST",
      "name": "pr.review-threads",
      "parameters": {
        "name": [
          "example-repo"
        ],
        "owner": [
          "example-org"
        ],
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "path": "/graphql",
      "requires": "pull",
      "response": "json"
    },
    {
      "accept": "application/vnd.github+json",
      "defaults": {
        "page": 1
      },
      "effect": "read",
      "fold": [
        "repository"
      ],
      "method": "GET",
      "name": "pr.reviews",
      "page": {
        "at": [],
        "parameter": "page",
        "size": 100
      },
      "parameters": {
        "page": {
          "max": 10000,
          "min": 1
        },
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "path": "/repos/{repository}/pulls/{pr}/reviews",
      "query": {
        "page": "{page}",
        "per_page": "100"
      },
      "requires": "pull",
      "response": "json"
    },
    {
      "accept": "application/vnd.github+json",
      "defaults": {
        "name": "example-repo",
        "owner": "example-org"
      },
      "effect": "read",
      "fold": [
        "repository"
      ],
      "graphql": {
        "document": "query AivmPullSummary($owner: String!, $name: String!, $number: Int!) { repository(owner: $owner, name: $name) { pullRequest(number: $number) { number title body url state reviewDecision headRefName baseRefName headRefOid headRepository { nameWithOwner } author { login } reviews(first: 100) { nodes { author { login } body state submittedAt } pageInfo { hasNextPage endCursor } } } } }",
        "operation": "AivmPullSummary",
        "variables": {
          "name": "name",
          "number": "pr",
          "owner": "owner"
        }
      },
      "method": "POST",
      "name": "pr.summary",
      "parameters": {
        "name": [
          "example-repo"
        ],
        "owner": [
          "example-org"
        ],
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "path": "/graphql",
      "requires": "pull",
      "response": "json"
    },
    {
      "effect": "read",
      "fold": [
        "repository"
      ],
      "name": "pr.view",
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "requires": "pull",
      "returns": "check"
    }
  ],
  "schema": 2,
  "service": "github-pr"
}
