{
  "schema": 2,
  "adapter": "https",
  "service": "github-pr",
  "host": "api.github.com",
  "authentication": "bearer",
  "headers": {
    "X-GitHub-Api-Version": "2026-03-10"
  },
  "credential_source": {
    "kind": "command",
    "argv": [
      "gh",
      "auth",
      "token",
      "--hostname",
      "github.com"
    ],
    "inherit_env": [
      "DBUS_SESSION_BUS_ADDRESS",
      "GH_CONFIG_DIR",
      "XDG_CONFIG_HOME",
      "XDG_RUNTIME_DIR"
    ]
  },
  "checks": {
    "pull": {
      "path": "/repos/{repository}/pulls/{pr}",
      "accept": "application/vnd.github+json",
      "require": [
        {
          "at": [
            "number"
          ],
          "equals_parameter": "pr"
        },
        {
          "at": [
            "base",
            "repo",
            "full_name"
          ],
          "equals": "example-org/example-repo",
          "fold": true
        },
        {
          "at": [
            "user",
            "login"
          ],
          "equals": "octocat",
          "fold": true
        },
        {
          "at": [
            "head",
            "repo",
            "full_name"
          ],
          "equals": "octocat/example-repo",
          "fold": true
        }
      ],
      "bind": {
        "head_sha": {
          "at": [
            "head",
            "sha"
          ],
          "format": "hex"
        }
      }
    }
  },
  "operations": [
    {
      "effect": "read",
      "method": "GET",
      "accept": "application/vnd.github+json",
      "requires": "pull",
      "fold": [
        "repository"
      ],
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ],
        "page": {
          "min": 1,
          "max": 10000
        }
      },
      "defaults": {
        "page": 1
      },
      "query": {
        "per_page": "100",
        "page": "{page}"
      },
      "page": {
        "size": 100,
        "parameter": "page",
        "at": [
          "check_runs"
        ]
      },
      "path": "/repos/{repository}/commits/{head_sha}/check-runs",
      "name": "pr.checks"
    },
    {
      "requires": "pull",
      "fold": [
        "repository"
      ],
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "effect": "write",
      "method": "POST",
      "path": "/repos/{repository}/issues/{pr}/comments",
      "accept": "application/vnd.github+json",
      "body_fields": {
        "body": 16384
      },
      "name": "pr.comment"
    },
    {
      "effect": "read",
      "method": "GET",
      "accept": "application/vnd.github+json",
      "requires": "pull",
      "fold": [
        "repository"
      ],
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ],
        "page": {
          "min": 1,
          "max": 10000
        }
      },
      "defaults": {
        "page": 1
      },
      "query": {
        "per_page": "100",
        "page": "{page}"
      },
      "page": {
        "size": 100,
        "parameter": "page"
      },
      "path": "/repos/{repository}/issues/{pr}/comments",
      "name": "pr.comments"
    },
    {
      "requires": "pull",
      "fold": [
        "repository"
      ],
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "effect": "read",
      "method": "GET",
      "path": "/repos/{repository}/pulls/{pr}",
      "accept": "application/vnd.github.diff",
      "response": "text",
      "name": "pr.diff"
    },
    {
      "requires": "pull",
      "fold": [
        "repository"
      ],
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "effect": "write",
      "method": "PATCH",
      "path": "/repos/{repository}/pulls/{pr}",
      "accept": "application/vnd.github+json",
      "body_fields": {
        "body": {
          "max_bytes": 16384,
          "optional": true
        },
        "title": {
          "max_bytes": 256,
          "optional": true
        }
      },
      "name": "pr.edit"
    },
    {
      "effect": "read",
      "method": "GET",
      "accept": "application/vnd.github+json",
      "requires": "pull",
      "fold": [
        "repository"
      ],
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ],
        "page": {
          "min": 1,
          "max": 10000
        }
      },
      "defaults": {
        "page": 1
      },
      "query": {
        "per_page": "100",
        "page": "{page}"
      },
      "page": {
        "size": 100,
        "parameter": "page"
      },
      "path": "/repos/{repository}/pulls/{pr}/comments",
      "name": "pr.review-comments"
    },
    {
      "effect": "read",
      "method": "GET",
      "accept": "application/vnd.github+json",
      "requires": "pull",
      "fold": [
        "repository"
      ],
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ],
        "page": {
          "min": 1,
          "max": 10000
        }
      },
      "defaults": {
        "page": 1
      },
      "query": {
        "per_page": "100",
        "page": "{page}"
      },
      "page": {
        "size": 100,
        "parameter": "page"
      },
      "path": "/repos/{repository}/pulls/{pr}/reviews",
      "name": "pr.reviews"
    },
    {
      "requires": "pull",
      "fold": [
        "repository"
      ],
      "parameters": {
        "pr": [
          7,
          8
        ],
        "repository": [
          "example-org/example-repo"
        ]
      },
      "effect": "read",
      "returns": "check",
      "name": "pr.view"
    }
  ],
  "cli": {
    "gh": [
      {
        "command": [
          "pr",
          "checks"
        ],
        "operation": "pr.checks",
        "positional": [
          "pr"
        ],
        "options": {
          "--repo": "repository",
          "-R": "repository",
          "--page": "page"
        }
      },
      {
        "command": [
          "pr",
          "comment"
        ],
        "operation": "pr.comment",
        "positional": [
          "pr"
        ],
        "options": {
          "--repo": "repository",
          "-R": "repository",
          "--body": "body",
          "--body-file": "@body"
        }
      },
      {
        "command": [
          "pr",
          "comments"
        ],
        "operation": "pr.comments",
        "positional": [
          "pr"
        ],
        "options": {
          "--repo": "repository",
          "-R": "repository",
          "--page": "page"
        }
      },
      {
        "command": [
          "pr",
          "diff"
        ],
        "operation": "pr.diff",
        "positional": [
          "pr"
        ],
        "options": {
          "--repo": "repository",
          "-R": "repository"
        },
        "output": "result"
      },
      {
        "command": [
          "pr",
          "edit"
        ],
        "operation": "pr.edit",
        "positional": [
          "pr"
        ],
        "options": {
          "--repo": "repository",
          "-R": "repository",
          "--body": "body",
          "--body-file": "@body",
          "--title": "title"
        }
      },
      {
        "command": [
          "pr",
          "review-comments"
        ],
        "operation": "pr.review-comments",
        "positional": [
          "pr"
        ],
        "options": {
          "--repo": "repository",
          "-R": "repository",
          "--page": "page"
        }
      },
      {
        "command": [
          "pr",
          "reviews"
        ],
        "operation": "pr.reviews",
        "positional": [
          "pr"
        ],
        "options": {
          "--repo": "repository",
          "-R": "repository",
          "--page": "page"
        }
      },
      {
        "command": [
          "pr",
          "view"
        ],
        "operation": "pr.view",
        "positional": [
          "pr"
        ],
        "options": {
          "--repo": "repository",
          "-R": "repository"
        }
      }
    ]
  },
  "lifetime_seconds": 1800,
  "max_requests": 200,
  "max_body_bytes": 8192
}
